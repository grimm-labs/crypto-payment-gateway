# Required
WALLET_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
# Outside APP_ENV=development the API refuses to boot unless Postgres uses
# verified TLS (…?sslmode=verify-full) and Redis uses TLS (rediss://…).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_payment
REDIS_URL=redis://localhost:6379

# Optional
APP_ENV=development
PORT=3000
LOG_LEVEL=info
# Escape hatch for the TLS rule above: "true" lets the API boot with plain-text
# Redis/Postgres outside development (warned at boot). Only when both are
# reachable over a private network. Empty/false = enforced.
ALLOW_INSECURE_TRANSPORT=

# Webhook endpoints and the default payment expiry are configured in the
# dashboard (Settings), not via environment variables.

# Admin dashboard auth (JWT_SECRET is required for /api/admin/v1; min 32 chars)
JWT_SECRET=
# Token the dashboard's /setup wizard asks for before creating the first admin
# (min 16 chars, e.g. `openssl rand -hex 32`). Empty: the API generates a
# one-time token at boot and logs it while no staff account exists.
SETUP_TOKEN=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Port the dashboard container listens on (docker compose)
DASHBOARD_PORT=8080
# Backend the dashboard container proxies /api to, resolved at container
# startup (docker compose sets it to the api service automatically; for a
# standalone deploy: docker run -e API_URL=https://api.example.com ...)
# API_URL=http://api:3000
# Optional CORS safety net when the dashboard is not served same-origin
CORS_ALLOWED_ORIGINS=
# Comma-separated CIDRs of the reverse proxies in front of the API (traffic log
# client IP). The API walks X-Forwarded-For from the right and keeps the first
# hop outside these ranges (empty = trust none, use the socket peer). List every
# proxy hop: the docker network's subnet behind the bundled dashboard nginx;
# under Kamal, the docker ranges plus the server's public IP (config/deploy.yml).
TRUSTED_PROXIES=
# API traffic log (Dashboard -> Traffic). Retention is configured in the
# dashboard Settings (90 days by default, or forever), not here.
API_TRAFFIC_ENABLED=true

# Blockchain providers
TRONGRID_API_KEY=
ALCHEMY_API_KEY=
HELIUS_API_KEY=

# Blockchain base URLs (mainnet). With CHAIN_MODE=testnet, comment them out:
# the defaults then point at Nile, Sepolia and Solana devnet.
TRONGRID_BASE_URL=https://api.trongrid.io
ETH_RPC_BASE_URL=https://eth-mainnet.g.alchemy.com/v2
HELIUS_RPC_BASE_URL=https://mainnet.helius-rpc.com
HELIUS_API_BASE_URL=https://api.helius.xyz

# Bitcoin on-chain (BIP84 addresses derived from WALLET_MNEMONIC).
# Esplora-compatible REST base URL; unset = Bitcoin disabled.
# BITCOIN_ESPLORA_BASE_URL=https://mempool.space/api
# Confirmations before a Bitcoin deposit counts as paid
# BTC_CONFIRMATIONS=3

# Lightning (BOLT11 invoices via the Breez SDK Spark, seeded with
# WALLET_MNEMONIC). Get an API key at https://breez.technology — never commit
# a real one. Unset = Lightning disabled.
BREEZ_API_KEY=
# Breez SDK local storage; resolved to an absolute path, must persist
# BREEZ_STORAGE_DIR=./.breez-data

# Withdrawals: "true" forces the outflow freeze (no withdrawal, sweep or gas
# top-up is signed or broadcast; the dashboard cannot lift it while set).
OUTFLOWS_FROZEN=

# Test chains (APP_ENV=development only): Sepolia, Nile, Solana devnet,
# Bitcoin testnet4 (tb1… addresses, coin type 1') and Spark regtest. There is
# no canonical testnet USDT: the three test-token contracts are required.
# Point BITCOIN_ESPLORA_BASE_URL at https://mempool.space/testnet4/api.
# CHAIN_MODE=testnet
# TESTNET_USDT_ETH_CONTRACT=
# TESTNET_USDT_TRON_CONTRACT=
# TESTNET_USDT_SOLANA_MINT=
