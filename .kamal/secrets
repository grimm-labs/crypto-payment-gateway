# Kamal secrets — references only, never write a value here.
# Every key below is read from the environment: the Deploy workflow
# (.github/workflows/deploy.yml) exports it from the GitHub environment's secrets;
# locally, export it yourself (or read it from a password manager, see `kamal docs env`).
# Clear settings (OUTFLOWS_FROZEN, BITCOIN_ESPLORA_BASE_URL…) live in config/deploy.yml.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
WALLET_MNEMONIC=$WALLET_MNEMONIC
# Passwords of the postgres and redis accessories (config/deploy.yml). They go
# into the URLs below unencoded: letters, digits, `-` and `_` only
# (e.g. `openssl rand -hex 32`).
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
REDIS_PASSWORD=$REDIS_PASSWORD
# The accessories' container names on the `kamal` docker network
# (<service>-<accessory>); plain text never leaves the server. Redis: the
# `default` user, explicitly (redis-cli rejects an empty user name).
DATABASE_URL=postgres://gateway:${POSTGRES_PASSWORD}@crypto-payment-gateway-postgres:5432/crypto_payment?sslmode=disable
REDIS_URL=redis://default:${REDIS_PASSWORD}@crypto-payment-gateway-redis:6379
JWT_SECRET=$JWT_SECRET
TRONGRID_API_KEY=$TRONGRID_API_KEY
ALCHEMY_API_KEY=$ALCHEMY_API_KEY
HELIUS_API_KEY=$HELIUS_API_KEY
BREEZ_API_KEY=$BREEZ_API_KEY
