# Kamal secrets — references only, never write a value here.
# Every key below is read from the environment: the Deploy workflow
# (.github/workflows/deploy.yml) exports it from the GitHub environment's secrets;
# locally, export it yourself (or read it from a password manager, see `kamal docs env`).

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
WALLET_MNEMONIC=$WALLET_MNEMONIC
DATABASE_URL=$DATABASE_URL
REDIS_URL=$REDIS_URL
JWT_SECRET=$JWT_SECRET
# Optional (empty: the API generates a one-time token at boot and logs it).
SETUP_TOKEN=$SETUP_TOKEN
TRONGRID_API_KEY=$TRONGRID_API_KEY
ALCHEMY_API_KEY=$ALCHEMY_API_KEY
HELIUS_API_KEY=$HELIUS_API_KEY
BREEZ_API_KEY=$BREEZ_API_KEY
